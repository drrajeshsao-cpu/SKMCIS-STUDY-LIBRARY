{
  "schema": "SKMCIS-world-class-disease-template-v1",
  "requiredDomains": [
    "identity/synonyms",
    "definition",
    "anatomy",
    "epidemiology global/local",
    "risk groups/occupation",
    "etiology/pathophysiology",
    "clinical phenotypes",
    "history",
    "red flags",
    "complete physical examination",
    "special tests + interpretation + diagnostic value",
    "anatomic/root localization",
    "severity grading",
    "differential comparison",
    "lab investigations with when/why",
    "imaging timeline",
    "X-ray findings/limitations",
    "CT indications",
    "MRI findings/correlation",
    "PET/DEXA only when relevant",
    "EMG/NCS when relevant",
    "conservative treatment timeline",
    "pharmacology evidence matrix",
    "interventions",
    "surgery indications/contraindications",
    "follow-up",
    "prognosis",
    "return-to-work/activity",
    "lifestyle/diet with reasoning",
    "complications/recurrence",
    "quick-recall pearls",
    "source map",
    "visual atlas slots"
  ],
  "formatRules": [
    "Point-to-point; avoid long paragraphs.",
    "Every test: how/positive/meaning/limitation/next decision.",
